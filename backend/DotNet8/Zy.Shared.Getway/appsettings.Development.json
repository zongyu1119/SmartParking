{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NacosConfig": {
    "Listeners": [
      {
        "Optional": false,
        "DataId": "getway",
        "Group": "dev"
      }
    ],
    "ServerAddresses": [ "http://192.168.1.8:8848/" ],
    "Optional": false,
    "Namespace": "e9b8c1b1-35f1-4d84-ab03-8deb87d5da7a",
    "UserName": "nacos",
    "Password": "nacos",
    "DefaultTimeOut": 15000,
    "ListenInterval": 1000,
    //服务发现
    "ServiceName": "getway",
    "GroupName": "dev",
    "ClusterName": "DEFAULT",
    "RegisterEnabled": true,
    "InstanceEnabled": true,
    "Ephemeral": true,
    "ConfigUseRpc": true,
    "NamingUseRpc": true,
    "LBStrategy": "WeightRoundRobin" //WeightRandom WeightRoundRobin
  },
  "Routes": [
    {
      // 用于服务发现的名称，也就是注册到nacos上的名称
      "ServiceName": "user",
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/user/{everything}",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 10010
        }
      ],
      "UpstreamPathTemplate": "/user/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "LoadBalancerOptions": {
        "Type": "LeastConnection"
      },
      // 使用服务发现
      "UseServiceDiscovery": true
    }
  ],
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      // 这里是重点
      "Type": "Nacos"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Default": {
        "Url": "http://localhost:8888"
      }
    }
  }
}
